  "dimExplanations": {
    "S1": {
      "L": "被夸第一反应是「啊？我吗？搞错了吧」，自我怀疑已成肌肉记忆。",
      "M": "自信随绩点曲线波动，期中崩了怀疑人生，期末杀回来又觉得自己行了。",
      "H": "对自己的斤两门儿清，路人评价属于背景噪音，已自动过滤。"
    },
    "S2": {
      "L": "「我是谁」这道题比高数还难，回答不出来先空着吧。",
      "M": "大体知道自己是什么型号，偶尔觉得需要重装系统重塑人生观",
      "H": "对自己的性格、底线和雷区都标好了地图，不轻易迷路。"
    },
    "S3": {
      "L": "做事先想「能不能平安落地」，至于理想是用来仰望不是用来追逐的。",
      "M": "心里有想追的方向，但膝盖偶尔会给现实下跪。",
      "H": "目标感清晰得像课表，知道每学期要干什么，不为短期优惠改航向。"
    },
    "E1": {
      "L": "对象半小时没回消息，已脑补完出轨分手复合三季剧情。",
      "M": "一半信任一半侦察兵，需要对方定期输入安全码才能续费安心。",
      "H": "不回消息就是真在忙，这点信心还是有的。"
    },
    "E2": {
      "L": "感情当成选修课，选了但随时准备退，学分不要了。",
      "M": "认真但不梭哈，给你七分，剩下三分留着防身。",
      "H": "一旦认定就直接把对方写进人生大纲，括号里标注「长期共建项目」。"
    },
    "E3": {
      "L": "拒绝人的难度约等于当众演讲，最后回了个「好滴」然后独自负重前行。",
      "M": "底线可微调，视对方是谁和当时的电量而定。",
      "H": "「不行」俩字说得干脆利落，分得清帮忙和替人负重是两回事。"
    },
    "A1": {
      "L": "看人自带安检扫描，先假设对方携带危险品再慢慢放行。",
      "M": "不信「人间自有真情在」但也懒得阴谋论，先观望。",
      "H": "愿意先递出一张好人卡，踩坑了自认倒霉，不因此把自己的门关死。"
    },
    "A2": {
      "L": "规则是死的人是活的，晚自习签到？人在床上也算签过。",
      "M": "该守的时候不马虎，该滑的时候也不死磕，灵活度随情境自动调节。",
      "H": "选了的课下刀子也去上，答应的事没人监督也要做完，主打一个靠谱。"
    },
    "A3": {
      "L": "人生意义？先活着吧，意义这种奢侈议题等交完ddl再议。",
      "M": "近几天开心就觉得人间值得，有事儿让自己累了烦躁了就觉得不值得，来回切换。",
      "H": "有自己的大方向，虽然也会迷惘但不会长期掉线，心里有颗北极星挂着。"
    },
    "Ac1": {
      "L": "动力源是外部供电——ddl快到了、辅导员在催、不能挂科丢人。",
      "M": "一半想搞点名堂出来，一半想安安静静苟过，两种模式随机切换。",
      "H": "发动机是内置的，不用人催不用ddl点火，自己就想把它做成做好。"
    },
    "Ac2": {
      "L": "选课纠结、点外卖纠结、连在哪个食堂吃都要脑内开个听证会。",
      "M": "会想，但不至于想到宕机，犹豫一阵还是能拍板的。",
      "H": "做决定像刷卡，滴一下搞定，选完不回头看，错了就当交学费。"
    },
    "Ac3": {
      "L": "和ddl有深厚感情，最后三天的产出约等于前三周的总和。",
      "M": "有时提前开工岁月静好，有时ddl前夜哭着冲刺，看运气。",
      "H": "项目一发布就建好文件夹，ddl前几天已经在润色第二版了。"
    },
    "So1": {
      "L": "主动社交≈公开处刑，进陌生群先潜水三个月观察生态。",
      "M": "有人来就接话，没人来也不硬凑，社交电量中度节能。",
      "H": "食堂排队能跟前面聊起来，朋友的朋友约等于我的朋友，先加了再说。"
    },
    "So2": {
      "L": "熟了就把人划进内圈，什么破事都分享，边界约等于不存在。",
      "M": "既想亲密又想留条缝，距离感根据对象和当天心情灵活浮动。",
      "H": "私人空间是神圣不可侵犯的结界，太近了会自动触发后退程序。"
    },
    "So3": {
      "L": "嘴上说「做自己」，实际在不同群聊切换不同人设，熟练得心疼自己。",
      "M": "大部分时候同一个人，偶尔根据场合微调音量大小和用词语气。",
      "H": "在教授面前和舍友面前一个样，懒得演，也不觉得需要演。"
    }
  },
